{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://xxjrq.github.io/ipinfo/schemas/providers.schema.json",
    "title": "EasyBR IP 资源库 — 服务商数据 Schema",
    "description": "src/data/providers.json 的 JSON Schema。服务商状态机：draft（默认，未人工核实）→ published（已核实发布，必须带 sourceUrls 与 updatedAt）→ outdated（信息过期）/ inactive（停止运营）。旧字段（verified/providerUrl/supportedProxyTypes/lastVerified/officialDocs）已废弃。",
    "type": "object",
    "required": [
        "updatedAt",
        "note",
        "providers"
    ],
    "additionalProperties": false,
    "properties": {
        "updatedAt": {
            "type": "string",
            "format": "date",
            "description": "本数据文件更新时间（YYYY-MM-DD）"
        },
        "note": {
            "type": "string",
            "description": "数据说明，含状态机语义"
        },
        "providers": {
            "type": "array",
            "description": "服务商列表，slug 全局唯一",
            "items": {
                "$ref": "#/$defs/provider"
            }
        }
    },
    "$defs": {
        "provider": {
            "type": "object",
            "required": [
                "name",
                "slug",
                "status",
                "officialUrl",
                "proxyTypes",
                "sourceUrls",
                "updatedAt"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "服务商展示名称，全局唯一"
                },
                "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "description": "URL 用短标识，全局唯一"
                },
                "status": {
                    "$ref": "#/$defs/enums/status"
                },
                "officialUrl": {
                    "type": "string",
                    "description": "官网地址；国内服务商未核实前可为空字符串"
                },
                "description": {
                    "type": "string",
                    "description": "一句话简介（含“资料待核验”提示）"
                },
                "pricingUrl": {
                    "type": "string",
                    "description": "价格页地址；未核验为空字符串"
                },
                "trialUrl": {
                    "type": "string",
                    "description": "免费试用入口地址；未核验为空字符串"
                },
                "proxyTypes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/proxyType"
                    }
                },
                "protocols": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/protocol"
                    }
                },
                "authentication": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/authentication"
                    }
                },
                "pricingModels": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/pricingModel"
                    }
                },
                "regions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "覆盖国家/地区描述（如 ['190+ 国家']），待核验为空数组"
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "亮点能力（待核验为空数组）"
                },
                "suitableFor": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "适用场景（待核验为空数组）"
                },
                "limitations": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "限制/不足（待核验为空数组）"
                },
                "geoGranularity": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/geoGranularity"
                    }
                },
                "sessionMode": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/sessionMode"
                    }
                },
                "targetUsers": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/targetUsers"
                    }
                },
                "selfService": {
                    "type": "boolean",
                    "description": "是否支持自助注册开通"
                },
                "trialAvailable": {
                    "type": "boolean",
                    "description": "是否提供免费试用"
                },
                "language": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/language"
                    }
                },
                "regionServed": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/enums/regionServed"
                    }
                },
                "sourceUrls": {
                    "type": "array",
                    "minItems": 0,
                    "items": {
                        "type": "object",
                        "required": [
                            "title",
                            "url"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "title": {
                                "type": "string"
                            },
                            "url": {
                                "type": "string",
                                "format": "uri"
                            }
                        }
                    },
                    "description": "信息来源（官网/文档等）；published 状态必须 ≥1 条"
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date",
                    "description": "最近核验/更新时间；published 状态必填"
                },
                "notes": {
                    "type": "string",
                    "description": "备注；数据未核验/字段缺失时注明“待核验”"
                },
                "related": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "description": "同类可替代服务商 slug 列表（2~4 个），用于正文『同类服务商』小节",
                    "default": []
                }
            },
            "allOf": [
                {
                    "description": "status=published 时必须有至少一条来源与更新时间",
                    "if": {
                        "properties": {
                            "status": {
                                "const": "published"
                            }
                        },
                        "required": [
                            "status"
                        ]
                    },
                    "then": {
                        "properties": {
                            "sourceUrls": {
                                "type": "array",
                                "minItems": 1
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date"
                            }
                        },
                        "required": [
                            "sourceUrls",
                            "updatedAt"
                        ]
                    }
                }
            ]
        },
        "enums": {
            "status": {
                "enum": [
                    "draft",
                    "published",
                    "outdated",
                    "inactive"
                ]
            },
            "proxyType": {
                "enum": [
                    "residential",
                    "static-residential",
                    "datacenter",
                    "mobile",
                    "isp"
                ]
            },
            "protocol": {
                "enum": [
                    "http",
                    "https",
                    "socks5"
                ]
            },
            "authentication": {
                "enum": [
                    "username-password",
                    "ip-whitelist",
                    "api"
                ]
            },
            "pricingModel": {
                "enum": [
                    "traffic",
                    "port",
                    "ip",
                    "package"
                ]
            },
            "geoGranularity": {
                "enum": [
                    "country",
                    "state",
                    "city",
                    "asn"
                ]
            },
            "sessionMode": {
                "enum": [
                    "rotating",
                    "sticky",
                    "fixed"
                ]
            },
            "targetUsers": {
                "enum": [
                    "enterprise",
                    "sme",
                    "personal"
                ]
            },
            "regionServed": {
                "enum": [
                    "global",
                    "cn",
                    "eu",
                    "na",
                    "asia"
                ]
            },
            "language": {
                "enum": [
                    "en",
                    "zh"
                ]
            }
        }
    }
}