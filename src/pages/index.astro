---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import { providers, updatedAt } from '../data/providers.json';

const base = import.meta.env.BASE_URL;
const downloadUrl =
	'https://www.ebrower.com/down.html?utm_source=ipinfo&utm_medium=landing&utm_campaign=download';

const quickEntries = [
	{ label: '住宅代理', desc: '真实家庭 IP，适合多账号防关联', href: 'proxy-types/residential-proxy/' },
	{ label: '静态住宅代理', desc: '长期固定 IP，适合稳定账号运营', href: 'proxy-types/static-residential-proxy/' },
	{ label: '数据中心代理', desc: '机房 IP，速度快、价格低', href: 'proxy-types/datacenter-vs-residential/' },
	{ label: '移动代理', desc: '4G/5G 移动 IP，真实运营商网络', href: 'proxy-types/mobile-proxy/' },
	{ label: 'HTTP/HTTPS 代理', desc: '网页与移动端通用代理协议', href: 'basics/http-https-proxy/' },
	{ label: 'SOCKS5 代理', desc: '任意 TCP/UDP 流量，兼容更多应用', href: 'basics/socks5-proxy/' },
];

const scenarios = [
	'跨境电商',
	'社媒账号',
	'广告验证',
	'数据采集',
	'Web3',
	'网站测试',
];

const configFlow = [
	'选择供应商',
	'获取代理参数',
	'添加到 EasyBR',
	'检测连接',
	'创建独立环境',
];
---

<StarlightPage
	frontmatter={{
		title: 'EasyBR IP 资源中心',
		description:
			'代理 IP 选型、配置、检测与指纹浏览器使用指南。找到合适的代理 IP，并快速配置到 EasyBR 免费指纹浏览器。',
	}}
>
	<main class="ip-landing">
		<!-- Hero -->
		<section class="ip-hero">
			<h1>找到合适的代理 IP，并快速配置到浏览器</h1>
			<p class="ip-subtitle">
				住宅 IP、数据中心 IP、SOCKS5 配置教程，覆盖 20+ 代理服务商，导入
				EasyBR 免费指纹浏览器即可使用。
			</p>
			<div class="ip-search">
				<div class="ip-search-box">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
					</svg>
					<input
						type="search"
						placeholder="搜索：NetNut、SOCKS5、住宅 IP"
						aria-label="站内搜索"
						autocomplete="off"
						id="ip-search-input"
					/>
				</div>
			</div>
			<div class="ip-hero-actions">
				<a class="ip-btn-primary" href="https://www.ebrower.com/down.html?utm_source=ipinfo&utm_medium=hero&utm_campaign=download" rel="noopener">免费使用 EasyBR</a>
				<a class="ip-btn-secondary" href={base + 'getting-started/intro/'}>查看配置教程</a>
			</div>
		</section>

		<!-- 快速入口 -->
		<section class="ip-section">
			<h2>快速入口</h2>
			<div class="ip-grid">
				{
					quickEntries.map((item) => (
						<a class="ip-card" href={base + item.href}>
							<h3>{item.label}</h3>
							<p>{item.desc}</p>
						</a>
					))
				}
			</div>
		</section>

		<!-- 服务商目录 -->
		<section class="ip-section">
			<h2>IP 服务商目录</h2>
			<div class="ip-grid">
				{
					providers.map((p) => (
						<a class="ip-card" href={base + 'providers/' + p.slug + '/'}>
							<div class="ip-provider-logo" aria-hidden="true">{p.name.slice(0, 1).toUpperCase()}</div>
							<h3>{p.name}</h3>
							<p>{(p.proxyTypes || []).join(' · ')}</p>
							<div class="ip-meta">
								{p.regions || '覆盖地区待核实'}
								{p.status === 'pending' ? ' · 资料待核实' : ''}
							</div>
						</a>
					))
				}
			</div>
		</section>

		<!-- 使用场景 -->
		<section class="ip-section">
			<h2>使用场景</h2>
			<div class="ip-grid">
				{
					scenarios.map((s) => (
						<div class="ip-card"><h3>{s}</h3><p>查看适用代理类型与配置教程</p></div>
					))
				}
			</div>
		</section>

		<!-- EasyBR 配置流程 -->
		<section class="ip-section">
			<h2>EasyBR 配置流程</h2>
			<div class="ip-steps">
				{
					configFlow.map((step) => (
						<div class="ip-step"><b>{step}</b><span>操作说明</span></div>
					))
				}
			</div>
		</section>

		<!-- 转化区 -->
		<section class="ip-cta">
			<h2>免费下载 EasyBR 指纹浏览器</h2>
			<ul class="ip-features">
				<li>5 个永久免费环境</li>
				<li>支持 HTTP / HTTPS / SOCKS5 代理</li>
				<li>Windows / macOS</li>
				<li>Cookie 与环境隔离</li>
			</ul>
			<a class="ip-btn-primary" href="https://www.ebrower.com/down.html?utm_source=ipinfo&utm_medium=cta&utm_campaign=download" rel="noopener">免费下载 EasyBR</a>
			<p class="ip-note">服务商目录更新时间：{updatedAt}。套餐与接口以服务商官方页面为准。</p>
		</section>
	</main>
</StarlightPage>

<style>
	/* 复用 custom.css 中的通用类，少量页面内补充 */
	a.ip-btn-primary {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.8rem;
		border-radius: 0.6rem;
		background: #722ed1;
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
</style>

<script>
	// 点击首页搜索框时，触发 Starlight 站内搜索弹窗
	const input = document.getElementById('ip-search-input');
	if (input) {
		input.addEventListener('click', () => {
			const btn = document.querySelector('site-search button[data-open-modal]');
			if (btn) (btn as HTMLElement).click();
			else input.focus();
		});
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				const btn = document.querySelector('site-search button[data-open-modal]');
				if (btn) (btn as HTMLElement).click();
			}
		});
	}
</script>