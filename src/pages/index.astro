---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { sponsor } from '../config/sponsor';

import { providers, updatedAt } from '../data/providers.json';

const base = import.meta.env.BASE_URL;

// 仅渲染已发布的正式内容页（草稿以 _ 前缀排除出构建，不在此集合中）
const published = await getCollection('docs');
const publishedSlugs = new Set(published.map((e) => e.id));

// 服务商数据：只展示 status=published 的条目（数据层状态机；当前 21 家均为 draft 待核验）
const publishedProviders = providers.filter((p) => p.status === 'published');

// 代理类型筛选条件（一期固定集合，供用户按类型浏览）
const proxyTypeFilters = [
	{ label: '住宅代理', slug: 'residential', desc: '真实家庭 IP，适合多账号防关联' },
	{ label: '静态住宅', slug: 'static-residential', desc: '长期固定 IP，适合稳定账号运营' },
	{ label: '数据中心', slug: 'datacenter', desc: '机房 IP，速度快、价格低' },
	{ label: '移动代理', slug: 'mobile', desc: '4G/5G 移动 IP，真实运营商网络' },
];

// 选型指南入口（已发布的正式文章）
const guideEntries = [
	{ label: '住宅代理服务商怎么选', desc: '从需求出发挑选住宅代理服务商', href: 'proxy-types/residential-proxy/' },
	{ label: '静态与动态住宅代理区别', desc: '粘性会话与轮换 IP 怎么选', href: 'proxy-types/static-residential-proxy/' },
	{ label: '数据中心与住宅代理区别', desc: '速度、价格与纯净度的取舍', href: 'proxy-types/datacenter-vs-residential/' },
	{ label: '使用场景', desc: '按业务场景倒推代理选型', href: 'use-cases/' },
].filter((e) => publishedSlugs.has(e.href.replace(/\/$/, '')));

const scenarios = ['跨境电商', '社媒账号', '广告验证', '数据采集', 'Web3', '网站测试'];
---

<StarlightPage
	frontmatter={{
		title: '代理 IP 资源导航与选型指南',
		description:
			'代理 IP 服务商资源导航与选型指南：整理住宅代理、静态住宅、数据中心代理与移动代理服务商，提供特点、覆盖范围、认证方式与使用场景参考。',
	}}
>
	<main class="ip-landing">
		<!-- Hero：先帮用户找到合适的 IP 资源 -->
		<section class="ip-hero">
			<h1>代理 IP 资源导航与选型指南</h1>
			<p class="ip-subtitle">
				整理住宅代理、静态住宅、数据中心代理与移动代理服务商，提供特点、覆盖范围、认证方式与使用场景参考。
			</p>
			<div class="ip-hero-actions">
				<a class="ip-btn-primary" href={base + 'providers/'}>浏览 IP 服务商</a>
				<a class="ip-btn-secondary" href={base + 'proxy-types/'}>按代理类型筛选</a>
			</div>
			<div class="ip-search">
				<div class="ip-search-box">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
					</svg>
					<input
						type="search"
						placeholder="搜索：NetNut、SOCKS5、住宅 IP"
						aria-label="站内搜索"
						autocomplete="off"
						id="ip-search-input"
					/>
				</div>
			</div>
		</section>

		<!-- 按代理类型筛选 -->
		<section class="ip-section">
			<h2>按代理类型筛选</h2>
			<div class="ip-grid">
				{
					proxyTypeFilters.map((f) => (
						<a class="ip-card" href={base + 'proxy-types/'}>
							<h3>{f.label}</h3>
							<p>{f.desc}</p>
						</a>
					))
				}
			</div>
		</section>

		<!-- 推荐资源（带理由与限制；未核验不显示为推荐） -->
		<section class="ip-section">
			<h2>推荐资源</h2>
			{
				publishedProviders.length > 0 ? (
					<div class="ip-grid">
						{
							publishedProviders.map((p) => (
								<a class="ip-card" href={base + 'providers/' + p.slug + '/'}>
									<div class="ip-provider-logo" aria-hidden="true">{p.name.slice(0, 1).toUpperCase()}</div>
									<h3>{p.name}</h3>
									<p>{(p.proxyTypes || []).join(' · ')}</p>
									<div class="ip-meta">{p.regions || '覆盖地区以官方页面为准'}</div>
								</a>
							))
						}
					</div>
				) : (
					<p class="ip-note">
						服务商资料正在逐批核验发布中，未核验的服务商不会出现在推荐列表。
						服务商收录条件与核验流程见
						<a href={base + 'about/how-we-review/'}>我们的推荐与核验规则</a>。
					</p>
				)
			}
		</section>

		<!-- 服务商目录表 -->
		<section class="ip-section">
			<h2>IP 服务商目录</h2>
			<p class="ip-note">
				完整服务商目录见 <a href={base + 'providers/'}>IP 服务商栏目</a>。
				结构化数据（JSON/CSV）可从此站 <a href={base + 'data/providers.json'}>providers.json</a> /
				<a href={base + 'data/providers.csv'}>providers.csv</a> 下载（仅含已核验发布的服务商）。
			</p>
		</section>

		<!-- 选型指南入口 -->
		<section class="ip-section">
			<h2>选型指南</h2>
			{
				guideEntries.length > 0 ? (
					<div class="ip-grid">
						{
							guideEntries.map((item) => (
								<a class="ip-card" href={base + item.href}>
									<h3>{item.label}</h3>
									<p>{item.desc}</p>
								</a>
							))
						}
					</div>
				) : (
					<div class="ip-grid">
						{
							['住宅代理怎么选', '静态与动态住宅区别', '数据中心与住宅区别', '低价代理风险'].map((s) => (
								<div class="ip-card"><h3>{s}</h3><p>指南编写中，敬请期待</p></div>
							))
						}
					</div>
				)
			}
			<div class="ip-grid">
				{
					scenarios.map((s) => (
						<a class="ip-card" href={base + 'use-cases/'}><h3>{s}</h3><p>查看适用代理类型与选型要点</p></a>
					))
				}
			</div>
		</section>

		<!-- 新手引导 -->
		<section class="ip-section">
			<h2>第一次使用代理 IP？</h2>
			<p class="ip-note">
				从 <a href={base + 'getting-started/'}>新手指南</a> 开始：了解什么是代理 IP、如何使用本站、
				以及「官方声明、本站核验、编辑推荐」三者的区别。
			</p>
		</section>

		<!-- EasyBR 配套工具（中下部；sponsor.enabled=false 时整块不渲染） -->
		{
			sponsor.enabled && (
				<section class="ip-cta">
					<h2>{sponsor.name}：指纹浏览器与代理环境管理工具</h2>
					<p>{sponsor.description}。选好代理后，可用 {sponsor.name} 为不同账号创建独立浏览器环境。</p>
					<ul class="ip-features">
						<li>5 个永久免费环境</li>
						<li>支持 HTTP / HTTPS / SOCKS5 代理</li>
						<li>Windows / macOS</li>
						<li>代理与环境独立绑定</li>
					</ul>
					<a class="ip-btn-primary" href={sponsor.downloadUrl + '?utm_source=ipinfo&utm_medium=cta&utm_campaign=download'} rel="noopener">免费下载 {sponsor.name}</a>
					<p class="ip-note">服务商目录更新时间：{updatedAt}。套餐与接口以服务商官方页面为准。</p>
				</section>
			)
		}

		<!-- 页脚规则链接 -->
		<section class="ip-section">
			<p class="ip-note">
				<a href={base + 'about/how-we-review/'}>推荐与核验规则</a> ·
				<a href={base + 'about/editorial-policy/'}>编辑政策</a> ·
				<a href={base + 'about/affiliate-disclosure/'}>推广披露</a> ·
				<a href={base + 'about/corrections/'}>内容纠错</a>
			</p>
		</section>
	</main>
</StarlightPage>

<style>
	/* 复用 custom.css 中的通用类，少量页面内补充 */
	a.ip-btn-primary {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.8rem;
		border-radius: 0.6rem;
		background: #722ed1;
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.ip-provider-logo {
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.5rem;
		background: #f3eaff;
		color: #722ed1;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}
</style>

<script>
	// 点击首页搜索框时，触发 Starlight 站内搜索弹窗
	const input = document.getElementById('ip-search-input');
	if (input) {
		input.addEventListener('click', () => {
			const btn = document.querySelector('site-search button[data-open-modal]');
			if (btn) (btn as HTMLElement).click();
			else input.focus();
		});
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				const btn = document.querySelector('site-search button[data-open-modal]');
				if (btn) (btn as HTMLElement).click();
			}
		});
	}
</script>
